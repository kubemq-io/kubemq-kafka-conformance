# Client track pins (the oracle and KubeMQ images stay in
# compose/versions.env). Images by OCI index digest (multi-arch); the tag is informational.

# Runtime image for the Go drivers (franz-go, sarama, segmentio): static binaries cross-compiled
# for the engine's architecture run here. distroless static-debian12:nonroot, resolved 2026-10-07.
GO_DRIVER_IMAGE=gcr.io/distroless/static-debian12@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# Client library versions. Go clients are pinned by go.mod/go.sum of suites/clients; the driver
# reports the version it actually linked, and the row's pinned version must match it.
FRANZ_GO_VERSION=v1.22.0

# Java kafka-clients driver: built with Maven, run on a JRE. Both images are multi-arch indexes,
# resolved 2026-10-07 (maven 3.9.16 on Temurin 21; Temurin 21.0.8+9 JRE).
JAVA_BUILD_IMAGE=docker.io/library/maven@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
JAVA_RUNTIME_IMAGE=docker.io/library/eclipse-temurin@sha256:66bb900643426ad01996d25bada7d56751913f9cec3b827fcb715d2ec9a0fbfc
KAFKA_CLIENTS_VERSION=4.3.1

# confluent-kafka-python driver (librdkafka bundled in the wheel; requirements.txt pins the wheel
# hashes for amd64 and arm64). python 3.12.12-slim-bookworm, multi-arch index, resolved 2026-10-07.
PYTHON_RUNTIME_IMAGE=docker.io/library/python@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
CONFLUENT_KAFKA_PYTHON_VERSION=2.15.1
SARAMA_VERSION=v1.61.0
SEGMENTIO_KAFKA_GO_VERSION=v0.4.51

# kcat driver: kcat 1.7.1 and librdkafka 2.10.0 from the Alpine 3.22 community repository, on
# alpine 3.22.2 (multi-arch index, resolved 2026-10-07). The apk versions are pinned exactly, so a
# rebuild fails loudly once Alpine publishes a newer revision (Alpine drops superseded revisions
# from its index); re-pin then. The prebuilt driver image, published by digest, is the
# reproducible artifact. The driver checks the loaded kcat and librdkafka versions every run.
KCAT_RUNTIME_IMAGE=docker.io/library/alpine@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412
KCAT_APK_VERSION=1.7.1-r2
LIBRDKAFKA_APK_VERSION=2.10.0-r0
JQ_APK_VERSION=1.8.2-r0

# confluent-kafka-go driver (cgo, bundled librdkafka): built on golang 1.27.1-bookworm, run on
# debian bookworm-20250929-slim (same glibc). Multi-arch indexes, resolved 2026-10-07. The client
# version is pinned by drivers/confluentgo/go.mod and go.sum.
CONFLUENTGO_BUILD_IMAGE=docker.io/library/golang@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66
CONFLUENTGO_RUNTIME_IMAGE=docker.io/library/debian@sha256:7e490910eea2861b9664577a96b54ce68ea3e02ce7f51d89cb0103a6f9c386e0
CONFLUENT_KAFKA_GO_VERSION=v2.15.1

# Confluent.Kafka (.NET) driver: .NET 8 SDK 8.0.425 and runtime 8.0.31 (bookworm-slim,
# multi-arch manifest lists, resolved 2026-10-07). The package graph is pinned by
# drivers/dotnet/packages.lock.json.
DOTNET_BUILD_IMAGE=mcr.microsoft.com/dotnet/sdk@sha256:ec9c0a0dc5f60adc2065762050638dd5ed5facfc53716d4580a42d86027c8e80
DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime@sha256:47c36b770db8f712ceb03e9220d799b068c769b8bc89c61d62cd41600633d9c2
CONFLUENT_KAFKA_DOTNET_VERSION=2.15.1

# KafkaJS driver: node 22.20.0 (bookworm-slim, multi-arch index, resolved 2026-10-07); KafkaJS
# 2.2.4 pinned by drivers/kafkajs/package-lock.json.
KAFKAJS_RUNTIME_IMAGE=docker.io/library/node@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
KAFKAJS_VERSION=2.2.4

# Spring Kafka driver: same pinned Maven and JRE images as the Java driver. Spring Kafka 4.1.1
# brings kafka-clients 4.2.1, which is what a Spring application runs unless it overrides it.
SPRING_BUILD_IMAGE=docker.io/library/maven@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
SPRING_RUNTIME_IMAGE=docker.io/library/eclipse-temurin@sha256:66bb900643426ad01996d25bada7d56751913f9cec3b827fcb715d2ec9a0fbfc
SPRING_KAFKA_VERSION=4.1.1

# Legacy client row: the java and python drivers copied unchanged into java-legacy and
# python-legacy, pinned to an older client. Same base images as the current drivers.
JAVA_LEGACY_BUILD_IMAGE=docker.io/library/maven@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320
JAVA_LEGACY_RUNTIME_IMAGE=docker.io/library/eclipse-temurin@sha256:66bb900643426ad01996d25bada7d56751913f9cec3b827fcb715d2ec9a0fbfc
KAFKA_CLIENTS_LEGACY_VERSION=3.9.1
PYTHON_LEGACY_RUNTIME_IMAGE=docker.io/library/python@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
CONFLUENT_KAFKA_PYTHON_LEGACY_VERSION=2.6.1

# Private registry of the prebuilt driver images (suites/clients/publish-drivers.sh).
DRIVER_REGISTRY=europe-docker.pkg.dev/kubemq/kafka-cert

# Prebuilt multi-arch driver images (linux/amd64 + linux/arm64) in the private registry
# europe-docker.pkg.dev/kubemq/kafka-cert, by index digest, with the source hash each was built
# from (suites/clients/publish-drivers.sh, 2026-10-07). build-driver.sh uses one only while its
# source hash matches the current sources; otherwise, or without registry access, it builds the
# driver locally.
FRANZGO_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/franzgo@sha256:54db595c5775de8841deced3e52509d5283e16c342942a2ac21752d09c483670
FRANZGO_DRIVER_SOURCE=a9251df76e258522
SARAMA_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/sarama@sha256:0d2a1c12ff2e5e14ffe280a72c736a19679541201ccf7b30182b730007277965
SARAMA_DRIVER_SOURCE=92335f30f5d0d0c3
SEGMENTIO_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/segmentio@sha256:c9ad5aed8ff4dceae5c78792908334489767acba3029eebfd9ba60f505abd8aa
SEGMENTIO_DRIVER_SOURCE=cbd8c7b73687afc5
PYTHON_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/python@sha256:255b22cd9189c0f45b1ba7ab361ae88abc04b7a06a1a7812bc9f906a129d0b19
PYTHON_DRIVER_SOURCE=11c5564654e17e50
KCAT_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/kcat@sha256:8812748f7b30ad5014f9abe96546fe0630c9cdc2d361a6496439563407c9a59e
KCAT_DRIVER_SOURCE=fb3fa3e5c219a2d8
KAFKAJS_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/kafkajs@sha256:00dd1741d344816a236d14c9be1e8cdaf8b76bdc67c8642913a5b5c407c23868
KAFKAJS_DRIVER_SOURCE=a9b3296775ceb970
JAVA_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/java@sha256:590558c31e2e7aa98167af89d7d57d2cd40c174551280e71806dc25e0e88d8f2
JAVA_DRIVER_SOURCE=21fc692fd322a7a0
SPRING_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/spring@sha256:cb88c763fad13e81e44f878463376d18b65cb8fdd62cca0c3f21432dff1ad34c
SPRING_DRIVER_SOURCE=061197fdb1cc8598
DOTNET_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/dotnet@sha256:9da0691d06659e3631b3a7fce38055ba3040cc051203b3d07a1d1b014c665574
DOTNET_DRIVER_SOURCE=69cd045ee69c5010
CONFLUENTGO_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/confluentgo@sha256:a1bdf383087516e52a8cc8dbe152315793b0aea9e39c77b46edc9f73d667be8f
CONFLUENTGO_DRIVER_SOURCE=d49a175718d7745d
JAVA_LEGACY_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/java-legacy@sha256:ddfabcbf8e8060bd7d2c510b734389b1a6b78023389cbd7bfb509b41c0d3d6e6
JAVA_LEGACY_DRIVER_SOURCE=5fc5909c7059d559
PYTHON_LEGACY_DRIVER_IMAGE=europe-docker.pkg.dev/kubemq/kafka-cert/python-legacy@sha256:fbae05b26f43a7675b27e6dbab24ea98960022d94603d02b4c269dc14297c3a4
PYTHON_LEGACY_DRIVER_SOURCE=0e9c7724bae48e98
