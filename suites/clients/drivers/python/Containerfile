# confluent-kafka-python driver of the clients track (SCENARIO.md). Built by
# suites/clients/build-driver.sh with the pinned image of suites/clients/clients.env.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r /app/requirements.txt
COPY driver.py /app/driver.py
USER 65532:65532
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/app/driver.py"]
