# Python orders application (confluent-kafka, librdkafka) of the app-sim track, and the image the
# verifier runs in, on the pinned Python image (suites/app-sim/app-sim.env).
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r /app/requirements.txt
COPY orders_app.py /app/orders_app.py
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/app/orders_app.py"]
