# Read by runner/certify.sh. Opt-in: the Schema Registry image is under the Confluent Community
# License, so this track runs only when the operator asks for it and accepts that license.
TRACK_TIER=opt-in
TRACK_CLIENTS=container
TRACK_LICENSE="Confluent Community License"
TRACK_LICENSE_ACCEPT_VAR=CERT_ACCEPT_CONFLUENT_COMMUNITY_LICENSE
