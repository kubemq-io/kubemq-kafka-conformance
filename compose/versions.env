# Single source of truth for every image and client version used by the certification runs.
# Images are pinned by OCI index digest (multi-arch). The tag is informational; the digest is
# what the engine pulls. Resolved 2026-10-05.
#
# To re-pin: resolve the index digest of the tag with
#   curl -sI -H "Accept: application/vnd.oci.image.index.v1+json" \
#     -H "Authorization: Bearer <anonymous token>" \
#     https://registry-1.docker.io/v2/apache/kafka/manifests/<tag>
# and record the Docker-Content-Digest header value here.

# Apache Kafka oracle (KRaft, single node). Same version is used for the CLI tools.
KAFKA_VERSION=4.3.1
KAFKA_IMAGE_REPO=docker.io/apache/kafka
KAFKA_IMAGE_DIGEST=sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837
# Per-architecture manifests inside the index above (recorded for audit only).
KAFKA_IMAGE_DIGEST_AMD64=sha256:ccd1314e47ec76909e01f86308b4dcf2064f19f7c89759234322314b0e319e26
KAFKA_IMAGE_DIGEST_ARM64=sha256:c2b5172ab20d66381ec1729796a410fd611135821994526d4d42d2f256054af3

# The latest KubeMQ image; runner/certify.sh resolves it to a digest at run start and the
# report records that digest.
KUBEMQ_VERSION=latest
KUBEMQ_IMAGE_REPO=europe-docker.pkg.dev/kubemq/images/kubemq-next
KUBEMQ_IMAGE_DIGEST=
KUBEMQ_IMAGE_DIGEST_AMD64=
KUBEMQ_IMAGE_DIGEST_ARM64=

# Client libraries (lockfiles per client pin the full dependency graph).
KAFKA_CLIENTS_VERSION=4.3.1
CONFLUENT_KAFKA_PYTHON_VERSION=2.15.1
FRANZ_GO_VERSION=v1.22.0
SARAMA_VERSION=v1.61.0
SEGMENTIO_KAFKA_GO_VERSION=v0.4.51

# Host ports. A run that is given no ports takes a free block of them chosen from its run id
# (runner/lib/preflight.sh pick_port_block), so several runs share a machine: 100 blocks of 20
# ports from CERT_PORT_BLOCK_BASE, 24000-25999. All below 32768: Linux hands out 32768-60999 and
# macOS 49152-65535 to outgoing connections, so a port in those ranges can be taken at any moment
# by any program's connection. None is a KubeMQ standard port (5672, 8080, 9090, 9092,
# 50000-50002), and none overlaps Kubernetes NodePorts (30000-32767), so a KubeMQ you already run
# on the machine is never dialed by mistake.
# To pin ports instead, export all four of KAFKA_HOST_PORT KAFKA_GATEWAY_PORT KUBEMQ_KAFKA_PORT
# KUBEMQ_API_PORT.
CERT_PORT_BLOCK_BASE=24000

# Lag and operations tools (tools track). Third-party images, pulled at run time, never
# redistributed. Burrow and kafka-lag-exporter publish linux/amd64
# only (they run emulated on arm64 hosts); kafka-lag-exporter is archived upstream (last release 0.8.2).
BURROW_IMAGE=ghcr.io/linkedin/burrow/burrow@sha256:8bee2af915972cab701680c415f6f5c10bd943bd847f0c83239b14b50d2ce226
BURROW_VERSION=v1.9.4
# Burrow's amd64 image crashes under emulation on arm64 hosts (SIGSEGV in the Go runtime's netpoll),
# and upstream's "-arm64" tags hold amd64 images. On a non-amd64 engine the tools track builds the
# same release from source (suites/tools/burrow/Containerfile): the v1.9.4 tag's commit, its GitHub
# archive checked by sha256, upstream's Go and Alpine versions, both by multi-arch index digest.
BURROW_SOURCE_COMMIT=e4598b791e8e10af54943d482aabba707526fca5
BURROW_SOURCE_SHA256=1050ed199cf93877055a512b9170733d6de72ed49db9d2e2ac70d510374542a6
BURROW_BUILD_IMAGE=docker.io/library/golang@sha256:43c094ad24b6ac0546c62193baeb3e6e49ce14d3250845d166c77c25f64b0386
BURROW_RUNTIME_IMAGE=docker.io/library/alpine@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507
KAFKA_LAG_EXPORTER_IMAGE=docker.io/seglo/kafka-lag-exporter@sha256:bc6205213421631aa70ab4bea3989874ceebb254cc41a16f50ec1cf9ddcf23c3
KAFKA_LAG_EXPORTER_VERSION=0.8.2
KAFBAT_UI_IMAGE=ghcr.io/kafbat/kafka-ui@sha256:8dd62c9b18a01b732824cae91c6fe5203fac8e931448a2a639bd20270b8fed2b
KAFBAT_UI_VERSION=v1.4.2
# Schema Registry (opt-in schema-registry track): Confluent Community License, pulled at run time only
# after CERT_ACCEPT_CONFLUENT_COMMUNITY_LICENSE=yes, never redistributed.
SCHEMA_REGISTRY_IMAGE=docker.io/confluentinc/cp-schema-registry@sha256:482d3048b3f6029bae5794b5c3b5e2eea8d61ca064dacd32241315e818fd8d7c
SCHEMA_REGISTRY_VERSION=8.3.2
